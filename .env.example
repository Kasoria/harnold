# Pflicht: Zugriffs-Token für die Web-UI (lang und zufällig, z. B. `openssl rand -hex 32`)
HARNOLD_TOKEN=
# Optional
ANTHROPIC_API_KEY=
HARNOLD_PORT=4317
# Nur für `docker compose --profile proxy up -d` (HTTPS via Caddy)
HARNOLD_DOMAIN=
# Zusätzliche Systempakete, durch Leerzeichen getrennt (z. B. "ffmpeg imagemagick"). Wirkt nur beim lokalen Bauen: docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
HARNOLD_APT_PACKAGES=
# Version des Images (Standard: latest). Zum Festnageln z. B. 0.11.0
HARNOLD_VERSION=
# Automatische Updates: true = neue Versionen nachts holen (Standard: false, dann per Knopf in der UI)
HARNOLD_AUTO_UPDATE=false
# Uhrzeit dafür (Sekunden Minuten Stunden Tag Monat Wochentag), Standard: täglich 03:17
HARNOLD_UPDATE_SCHEDULE=
