# Pflicht: Zugriffs-Token für die Web-UI (lang und zufällig, z. B. `openssl rand -hex 32`)
HARNOLD_TOKEN=
# Optional
ANTHROPIC_API_KEY=
HARNOLD_PORT=4317
# Nur für `docker compose --profile proxy up -d` (HTTPS via Caddy)
HARNOLD_DOMAIN=
# Zusätzliche Systempakete, durch Leerzeichen getrennt (z. B. "ffmpeg imagemagick"). Wirkt nach `docker compose up -d --build`.
HARNOLD_APT_PACKAGES=
# Version des Images (Standard: latest). Zum Festnageln z. B. 0.11.0
HARNOLD_VERSION=
# Zeitplan für das Profil "autoupdate" (Sekunden Minuten Stunden Tag Monat Wochentag), Standard: täglich 04:00
HARNOLD_UPDATE_SCHEDULE=
