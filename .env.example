# Pflicht: Zugriffs-Token für die Web-UI (lang und zufällig, z. B. `openssl rand -hex 32`)
HARNOLD_TOKEN=
# Optional
ANTHROPIC_API_KEY=
HARNOLD_PORT=4317
# Nur für `docker compose --profile proxy up -d` (HTTPS via Caddy)
HARNOLD_DOMAIN=
# Zusätzliche Systempakete, durch Leerzeichen getrennt (z. B. "ffmpeg imagemagick"). Wirkt nach `docker compose up -d --build`.
HARNOLD_APT_PACKAGES=
